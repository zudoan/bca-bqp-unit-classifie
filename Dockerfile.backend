FROM python:3.11-slim

WORKDIR /app

# Copy requirements for backend only (no Gradio)
COPY requirements-backend.txt .

# Install dependencies from official PyPI
RUN pip install --upgrade pip && \
    pip install --default-timeout=600 \
    --no-cache-dir -r requirements-backend.txt

# Copy source code
COPY api ./api
COPY matching ./matching
COPY preprocessing ./preprocessing
COPY search ./search
COPY data ./data

# Create storage directory for database
RUN mkdir -p /app/storage && chmod 777 /app/storage

# Expose port
EXPOSE 7860

# Run FastAPI only (no Gradio)
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "7860"]
